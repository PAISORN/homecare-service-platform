{
  "expo": {
    "name": "HomeCare",
    "slug": "homecare",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "homecare",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8FAFC"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "อนุญาตให้ HomeCare เลือกรูปเอกสารยืนยันตัวตนที่คุณเป็นผู้ส่งเท่านั้น",
          "cameraPermission": "อนุญาตให้ HomeCare ใช้กล้องเพื่อถ่ายเอกสารยืนยันตัวตนและภาพใบหน้าของคุณ",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "อนุญาตให้ HomeCare ใช้ตำแหน่งขณะเปิดแอปเพื่อปักหมุดสถานที่และแชร์ตำแหน่งช่างระหว่างเดินทาง"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.homecare.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.homecare.mobile"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "61eb4406-c211-4119-9857-4add2593d070"
      }
    },
    "owner": "amsol"
  }
}
