# คัดลอกเป็น .env.production บน VPS เท่านั้น และห้าม commit ไฟล์จริง
ADMIN_INTERNAL_PORT=3000
ADMIN_DOMAIN=admin.example.com
SUPABASE_DOMAIN=api.example.com
NEXT_PUBLIC_SUPABASE_URL=https://api.example.com
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-self-hosted-publishable-key
# ใช้เฉพาะฝั่ง server ใน Admin container และห้ามใช้ชื่อ NEXT_PUBLIC_*
SUPABASE_INTERNAL_URL=http://host.docker.internal:8000
