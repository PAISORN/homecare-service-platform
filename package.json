{
  "name": "homecare",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @homecare/mobile --filter @homecare/admin dev",
    "dev:mobile": "pnpm --filter @homecare/mobile dev",
    "dev:admin": "pnpm --filter @homecare/admin dev",
    "build": "pnpm --filter @homecare/mobile build && pnpm --filter @homecare/admin build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "security:check": "node scripts/security-preflight.mjs",
    "ops:check:contacts": "node scripts/verify-pilot-incident-roster.mjs",
    "env:local-vps:prepare": "node scripts/prepare-local-vps-environment.mjs",
    "env:local-vps:up": "node scripts/run-local-vps-environment.mjs up",
    "env:local-vps:check": "node scripts/run-local-vps-environment.mjs check",
    "env:local-vps:down": "node scripts/run-local-vps-environment.mjs down",
    "selfhost:prepare": "node scripts/prepare-self-hosted-rehearsal.mjs",
    "selfhost:up": "node scripts/run-self-hosted-rehearsal.mjs up",
    "selfhost:migrate": "node scripts/run-self-hosted-rehearsal.mjs migrate",
    "selfhost:db:test": "node scripts/run-self-hosted-rehearsal.mjs db-test",
    "selfhost:check": "node scripts/run-self-hosted-rehearsal.mjs check",
    "selfhost:persistence": "node scripts/run-self-hosted-rehearsal.mjs persistence",
    "selfhost:backup-restore": "node scripts/run-self-hosted-rehearsal.mjs backup-restore",
    "selfhost:storage:backup-restore": "node scripts/run-self-hosted-rehearsal.mjs storage-backup-restore",
    "selfhost:down": "node scripts/run-self-hosted-rehearsal.mjs down",
    "validate:mobile:native": "pnpm --filter @homecare/mobile validate:native",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:cli:version": "node scripts/run-supabase-command.mjs --version",
    "db:start": "node scripts/start-supabase.mjs",
    "db:stop": "node scripts/run-supabase-command.mjs stop --no-backup",
    "db:reset": "node scripts/reset-database.mjs",
    "db:test": "node scripts/test-database.mjs",
    "db:test:identity": "node scripts/test-mobile-identity-bootstrap.mjs",
    "db:test:storage": "node scripts/test-technician-document-storage.mjs && node scripts/test-technician-document-quota.mjs && node scripts/test-request-attachment-storage.mjs && node scripts/test-service-quality-evidence-storage.mjs",
    "db:lint": "node scripts/lint-database.mjs",
    "db:types": "node scripts/generate-database-types.mjs",
    "db:drill:restore": "node scripts/verify-local-backup-restore.mjs"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "supabase": "2.115.0",
    "typescript": "~6.0.3"
  }
}
